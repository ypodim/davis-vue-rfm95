# Copy to /etc/davis-mqtt.env, chmod 600, fill in. Read by davis-mqtt.service.
# Keep this file out of version control -- it names your hosts and holds a password.

# Broker. Use MQTT_TLS=1 with port 8883 for anything reachable over the internet.
MQTT_HOST=mqtt.example.org
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=site-a
MQTT_PASSWORD=change-me

# Site identity. Make DAVIS_NODE unique per site so a second station never
# collides in Home Assistant; the topic base and device name are what humans see.
DAVIS_NODE=davis_vue_site_a
DAVIS_TOPIC_BASE=site-a/davis
DAVIS_DEVICE_NAME=Davis Vantage Vue (Site A)

# Feather's serial port. /dev/serial/by-id/... is more stable if other USB
# serial devices share the host.
DAVIS_SERIAL=/dev/ttyACM0

# 0.01 for US buckets, 0.007874 for metric (0.2 mm).
DAVIS_RAIN_BUCKET=0.01

# Seconds without a packet before the device is reported unavailable.
DAVIS_STALE_AFTER=120
